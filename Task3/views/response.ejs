<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width = device-width, initial-scale=1.0">
        <title>Register Successful</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            *{
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            body{
                font-family: Arial,Sans-serif;
            }
            .response-section{
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                position: relative;
                overflow: hidden;
                padding: 50px 20px;
                color: white;
                background: linear-gradient(135deg, #6b21a8,#312e81,#1d4ed8);
            }
            .response-section::before{
                content: "";
                position: absolute;
                width: 180px;
                height: 180px;
                top: 8%;
                right: 7%;
                border-radius: 20px;
                border: 3px solid rgba(196, 181, 253, 0.45);
                transform: rotate(45deg);
                animation: rotate 11s ease-in-out infinite;
            }
            .response-section::after{
                content: "";
                position: absolute;
                width: 120px;
                height: 120px;
                bottom: 8%;
                left: 7%;
                border-radius: 15px;
                border: 3px solid rgba(96, 165, 250, 0.6);
                transform: rotate(45deg);
                animation: rotate 9s linear infinite;
            }
            .response-card{
                width: 100%;
                max-width: 650px;
                position: relative;
                z-index: 1;
                padding: 45px;
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255, 255, 255, 0.35);
                border-radius: 22px;
                backdrop-filter: blur(15px);
                -webkit-backdrop-filter: blur(15px);
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
            }
            .success-icon{
                width: 75px;
                height: 75px;
                margin: 0 auto 20px;
                display: flex;
                justify-content: center;
                align-items: center;
                border: 5px solid #2dd4bf;
                border-radius: 50%;
                color: #2dd4bf;
                font-size: 40px;
                font-weight: bold;
            }
            .success-label{
                display: block;
                text-align: center;
                color: #2dd4bf;
                font-size: 13px;
                font-weight: bold;
                letter-spacing: 3px;
                margin-bottom: 15px;
            }
            h1{
                text-align: center;
                font-size: 45px;
                margin-bottom: 15px;
            }
            .message{
                text-align: center;
                color: rgba(255, 255, 255, 0.8);
                line-height: 1.7;
                margin-bottom: 30px;
            }
            .divider{
                height: 1px;
                background: rgba(255, 255, 255, 0.2);
                margin: 30px 0;
            }
            .details-title{
                margin-bottom: 15px;
                font-size: 20px;

            }
            .detail-row{
                display: flex;
                padding: 14px 5px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            }
            .detail-label{
                width: 35%;
                color: rgba(255, 255, 255, 0.65);
            }
            .detail-value{
                width: 65%;
                color: white;
                font-weight: 600;
            }
            .home-button{
                display: block;
                width: 100%;
                margin-top: 30px;
                padding: 16px;
                text-align: center;
                text-decoration: none;
                color: white;
                font-weight: bold;
                border-radius: 10px;
                background: linear-gradient(90deg,#2584ff,#4f46e5,#7c3aed);
                transition: 0.3s;
            }
            .home-button:hover{
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
            }
            @keyframes rotate{
                from{
                    transform: rotate(45deg);
                }
                to{
                    transform: rotate(405deg);
                }
            }
            @media (max-width:600px){
                .response-card{
                    padding: 30px 20px;

                }
                h1{
                    font-size: 35px;
                }
                .response-section::before{
                    width: 110px;
                    height: 110px;
                }
                .response-section::after{
                    width: 80px;
                    height: 80px;
                }
            }
            
        </style>
    </head>
    <body>

        <section class="response-section">
            <div class="response-card">
                <div class="success-icon">✔</div>
                <span class="sucessful-label">REGISTRATION SUCCESSFUL</span>
                <h1>Thank You!</h1>
                <p class="message">Your account has been created successfully.<br>
                We've recived your information and everything looks good.</p>
                <div class="divider"></div>
                <h3 class="details-title">Your Details</h3>
                <div class="detail-row">
                    <span class="detail-label">Name</span>
                    <span class="detail-value"><%= user.name%></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Email</span>
                    <span class="detail-value"><%= user.email%></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Age</span>
                    <span class="detail-value"><%= user.age%></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Gender</span>
                    <span class="detail-value"><%= user.gender%></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">City</span>
                    <span class="detail-value"><%= user.city%></span>
                </div>
                <a href="/" class="home-button">🛖 Back to Home</a>
            </div>
        </section>



        <div class="response-section">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <div class="response-content">
                        <h1>Registration Successful</h1>
                        <h2>Thank You,<span> <%= user.name %>!</span></h2>
                        <p>Your registration has been successfully processed and validated by the server.</p>
                        <a href = "/" class = "btn btn-primary custom-button">Go To Home</a>
                    </div>
                </div>

                <div class = "col-lg-5 ">
                        <div class = "response-card">
                            <h3>Your Details:</h3>
                            <div class = "response-list">
                                <div class="response-item">
                                    <span>01</span>
                                    <p><strong>Email:</strong> <%= user.email %></p>
                                </div>
                                <div class="response-item">
                                    <span>02</span>
                                    <p><strong>Age:</strong> <%= user.age %></p>
                                </div>
                                <div class="response-item">
                                    <span>03</span>
                                    <p><strong>Gender:</strong> <%= user.gender %></p>
                                </div>
                                <div class="response-item">
                                    <span>04</span>
                                    <p><strong>City:</strong> <%= user.city %></p>
                                </div>
                            </div>
                        </div>
                    </div>

            </div>  
        </div>
      
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
       
    </body>
</html>