        <section id = "registration" class = "page-section registration-section">
            <div class="container">

                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="section-heading">
                            <span class = "section-label">REGISTRATION</span>
                            <h2>How Registration Works</h2>
                            <p>Before filling out the registration form, lets understand 
                                what happens internally when you submit your information</p>
                        </div>

                        <div class="process-card">

                            <div class="process-step">
                                <div class="step-number">
                                    01
                                </div>
                                <div>
                                    <h4>Fill the Registration Form</h4>
                                    <p>Enter your personal information such as name, email, age, gender, city and password.</p>
                                </div>
                            </div>

                            <div class="process-line"></div>

                            <div class="process-step">
                                <div class="step-number">
                                    02
                                </div>
                                <div>
                                    <h4>Submit the Form</h4>
                                    <p>The form sends the submitted information to the Express server using a POST request.</p>
                                </div>
                            </div>

                            <div class="process-line"></div>

                            <div class="process-step">
                                <div class="step-number">
                                    03
                                </div>
                                <div>
                                    <h4>Server Validation</h4>
                                    <p>The server validates the submitted data and checks for any errors or missing information.</p>
                                </div>
                            </div>

                            <div class="process-line"></div>

                            <div class="process-step">
                                <div class="step-number">
                                    04
                                </div>
                                <div>
                                    <h4>Temporary Storage</h4>
                                    <p>Validated information is stored temporarily on the server.</p>
                                </div>
                            </div>

                            <div class="registration-action">
                                <a href = "/register" class = "btn btn-primary custom-button">Go To Registration</a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
