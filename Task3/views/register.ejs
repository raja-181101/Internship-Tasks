<!DOCTYPE html>
<html>
    <head>
        <title>Registration Form</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="/style.css">
    </head>
    <body class="register-page">
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
                <div class="container">
                    <a class="navbar-brand fw-bold" href="/">Task 3</a>
                    <div class="ms-auto">
                        <a class="nav-link text-light" href="/">Home</a>
                    </div>
                </div>
        </nav>

        <section class="register-section">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-7 col-md-9">
                        <div class="register-card">
                            <div class="register-heading text-center">
                                <span class="section-label">REGISTRATION</span>
                                <h1>Create Your Account</h1>
                                <p>Enter your information. The submitted data will be validated by both the browser and the Express server.</p>

                            </div>

                            <%if(errors && errors.length>0){%>
                                <div class="alert alert-danger">
                                    <%errors.forEach(error=>{%>
                                        <p class="mb-1">
                                            <%=error%>
                                        </p>
                                        <%})%>
                                </div>
                            <%}%>

                            <form action="/register" method="post" onsubmit="return checkedForm()" novalidate>

                                <div class="mb-3">
                                    <label class="form-label" for="name">Name</label>
                                    <input type="text" id="name" name="name" placeholder="Enter Your Name" class="form-control" value="<%=formData?.name || ''%>" oninput="verifyName()">
                                    <p id="nameError" class="text-danger"></p>

                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="email">Email</label>
                                    <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email" value="<%=formData?.email || ''%>" oninput="verifyEmail()">
                                    <p id="emailError" class="text-danger"></p>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="age">Age</label>
                                    <input type="number" id="age" name="age" class="form-control" placeholder="Enter your age" value="<%=formData?.age || ''%>" oninput="verifyAge()">
                                    <p id="ageError" class="text-danger"></p>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label d-block">Gender</label>
                                    <div class="gender-options">
                                        <label class="gender-option">
                                            <input type="radio" name="gender" value="male" <%= formData?.gender === 'male' ? 'checked': ''%>>Male
                                        </label>

                                        <label class="gender-option">
                                            <input type="radio" name="gender" value="female" <%= formData?.gender === 'female' ? 'checked' : ''%>>Female
                                        </label>

                                    </div>
                                    <p id="genderError" class="text-danger"></p>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="city">City</label>
                                    <select id="city" name="city" class="form-select">
                                        <option value="">Select City</option>
                                        <option value="Hyderabad" <%= formData?.city === 'Hyderabad'? 'selected': ''%>>Hyderabad</option>
                                        <option value="Bangalore" <%= formData?.city ==='Bangalore'? 'selected': ''%>>Bangalore</option>
                                        <option value="Chennai" <%= formData?.city ==='Chennai'? 'selected': ''%>>Chennai</option>
                                        <option value="Coiambatore" <%= formData?.city ==='Coiambatore'? 'selected': ''%>>Coiambatore</option>
                                        <option value="Kochi" <%= formData?.city ==='Kochi'? 'selected': ''%>>Kochi</option>
                                        <option value="Mysuru" <%= formData?.city ==='Mysuru'? 'selected': ''%>>Mysuru</option>
                                        <option value="Vishakapatanam" <%= formData?.city ==='Vishakapatanam'? 'selected': ''%>>Vishakapatanam</option>
                                        <option value="Nodia" <%= formData?.city ==='Nodia'? 'selected': ''%>>Nodia</option>
                                        <option value="Delhi" <%= formData?.city ==='Delhi'? 'selected': ''%>>Delhi</option>
                                    </select>
                                    <p id="cityError" class="text-danger"></p>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="password">Password</label>
                                        <input type="password" placeholder="Enter your password" id="password" name="password" class="form-control" oninput="verifyPassword()">
                                        <p id="passwordError" class="text-danger"></p>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="confirPassword">Confirm Password</label>
                                        <input type="password" placeholder="Enter your password" id="confirmPassword" name="confirmPassword" class="form-control">
                                        <p id="confirmpasswordError" class="text-danger"></p>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary custom-button w-100">
                                    Register
                                </button>

                                </form>

                                <div class="mt-4 text-center">
                                    <a class="back-home-link" href="/"> ⬅ Back to Home</a>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </section>

        

    <script>

            function verifyName() {
                const nameInput = document.getElementById('name');
                const error = document.getElementById('nameError');
                const nameValue = nameInput.value.trim();
                const nameRegex = /^[A-Za-z\s]+$/;

                if (!nameRegex.test(nameValue) || nameValue.length<3) {
                    error.innerHTML = 'Name should contain only letters and spaces.';
                } else {
                    error.innerHTML = ''; 
                }
            }
            function verifyEmail(){
                const email = document.getElementById('email');
                const emailValue = email.value;
                const emailRegax =  /^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+$/;
                const error = document.getElementById('emailError');

                if(!email || !emailRegax.test(emailValue)){
                    error.innerHTML = "Enter Valid Email.";
                }else{
                    error.innerHTML = '';
                }

            }
            function verifyAge(){
                const age = document.getElementById('age');
                const error = document.getElementById('ageError');
                const ageValue = age.value;


                if(!age || isNaN(ageValue) || ageValue < 18 || ageValue > 100){
                    error.innerHTML = "Enter age between 18 - 100 only!";
                }else{
                    error.innerHTML = '';
                }

            }
            function verifyPassword(){
                const password = document.getElementById('password');
                const error = document.getElementById('passwordError');
                const passwordValue = password.value;

                if(!password || passwordValue.length < 6){
                    error.innerHTML = "Password must be more then 6 Characters!";
                }else{
                    error.innerHTML = '';
                }

            }

            function checkedForm() {
                const password = document.getElementById('password').value;
                const confirmPassword = document.getElementById('confirmPassword').value;
                const email = document.getElementById('email').value;
                const age = document.getElementById('age').value;
                const city = document.getElementById('city').value;
                const gender = document.querySelector('input[name="gender"]:checked');
                const emailRegax = /^\S+@\S+\.\S+$/;

                
                if(!email || !emailRegax.test(email)){
                   alert('Invalid email format!');
                   return false;
                }

                if(!age || isNaN(age) || age < 18 || age > 100){
                    alert('Age must be a number between 18 and 100!');
                    return false;
                }

                if(!gender){
                    alert('Please select a gender!');
                    return false;
                }

                if(!city){
                    alert('Please select a city!');
                    return false;
                }

                if(!password || password.length < 6){
                    alert('Password must be at least 6 characters long!');
                    return false;
                }

                if (password !== confirmPassword) {
                    alert('Passwords do not match!');
                    return false;
                }
                return true;
            }
        </script>
    </body>
    
</html>