<!DOCTYPE html>
<html>
    <head>
        <title>Register Successful</title>
        <style>
            .responce_container{
                width: 400px;
                margin: auto;
                text-align: center;
                padding: 20px;
                border: 1px solid #ccc;
                border-radius: 5px;
                box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            }
        </style>
    </head>
    <body>
        <div class="responce_container">
            <h1>Registration Successful!</h1>
            <p><strong><%= name %>!</strong> Thank You For Registering.</p>
            <h4>Your Details:</h4>
            <p><strong>Email:</strong> <%= email %></p>
            <p><strong>Age:</strong> <%= age %></p>
            <p><strong>Gender:</strong> <%= gender %></p>
            <p><strong>City:</strong> <%= city %></p>
        </div>
       
    </body>
</html>